{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surveo",
  "mainBinaryName": "surveo-console",
  "version": "0.3.0",
  "identifier": "fr.surveo.console",
  "build": { "frontendDist": "../../ui/dist/console" },
  "app": {
    "windows": [
      { "label": "main", "title": "Surveo", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
